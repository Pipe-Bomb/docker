# Public URL of your Pipe Bomb instance (the address you open in a browser).
# Used for CORS — must match the origin you access the app from.
PUBLIC_URL=http://localhost

# Port that nginx listens on externally.
HTTP_PORT=80

# Optional: set if using a custom domain so auth cookies scope correctly.
# COOKIE_DOMAIN=mynas.local

# Database backend: sqlite (default) or postgres
DB_TYPE=sqlite

# PostgreSQL settings — only needed when DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=pipebomb
# DB_PASS=changeme
# DB_NAME=pipebomb
