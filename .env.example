# Public URL of your Pipe Bomb instance (the address you open in a browser).
# Used for CORS - must match the origin you access the app from.
PUBLIC_URL=http://localhost

# Port that nginx listens on externally.
HTTP_PORT=80

# Path where Pipe Bomb stores its data (database, plugins, cache, etc.).
# Defaults to ./data relative to this file.
# APPDATA_PATH=/path/to/appdata/pipe-bomb

# Optional: path to your local music library (for the local-library plugin).
# Uncomment the music volume in docker-compose.yml when setting this.
# MUSIC_PATH=/path/to/music